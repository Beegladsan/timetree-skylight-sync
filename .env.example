# Copy to `.env` for LOCAL runs only. NEVER commit the real .env.
# In GitHub Actions these are set as repository Secrets/Variables instead.

# --- Credentials: provide EITHER a session token OR email+password ---
# Reusing a session token avoids logging in on every run (fewer rate-limit /
# lockout risks). See the runbook for how to extract _session_id.
# TIMETREE_SESSION_ID=

TIMETREE_EMAIL=you@example.com
TIMETREE_PASSWORD=your-timetree-password

# --- Which calendar to export (numeric id, alias code, or exact name) ---
# Discover it with:  python sync.py --list-calendars
TIMETREE_CALENDAR_ID=123456

# --- Feed presentation / hosting ---
FEED_NAME=Our Family
# Unguessable path segment so the public URL is hard to discover.
# Generate one with:  python -c "import uuid;print(uuid.uuid4().hex)"
FEED_SLUG=change-me-to-a-random-hex-string
# Where the feed will be written locally (CI overrides this).
FEED_OUTPUT=_site/feed/change-me/calendar.ics

# --- Guardrails (optional) ---
# Fail if the event count drops by more than this fraction vs the live feed.
MAX_DROP_RATIO=0.5
# Set to 1/true to allow publishing an empty feed (default: refuse).
# ALLOW_EMPTY=0
# Live feed URL used for the drop-guard baseline (set after first deploy).
# BASELINE_URL=https://you.github.io/timetree-skylight-sync/feed/<slug>/calendar.ics
